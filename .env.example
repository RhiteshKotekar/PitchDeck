# LaunchDeck Client Environment Variables
# Copy this file to .env and fill in your values

# Clerk publishable key from your Clerk dashboard
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend API URL (local development)
# Android emulator: http://10.0.2.2:3000
# Physical device: use your computer's local network IP
EXPO_PUBLIC_API_URL=http://localhost:3000
