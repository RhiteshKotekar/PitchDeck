# Pitchboard Client Environment Variables
# Copy this file to .env and fill in your values

# Clerk publishable key from your Clerk dashboard (https://dashboard.clerk.com)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend API URL (default for local development)
# For Android emulator use http://10.0.2.2:3000
# For physical device use your local IP, e.g. http://192.168.1.X:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

